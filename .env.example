# ── Vision/text LLM (agents 1 and 3): Ollama on the MacBook, exposed through ngrok ──
OLLAMA_HOST=https://YOUR-SUBDOMAIN.ngrok-free.app
# user:pass matching `ngrok http 11434 --basic-auth "user:pass"` on the Mac (strongly recommended)
OLLAMA_BASIC_AUTH=
# Model used by the prompt writer and the evaluator (must accept images). Override per agent if you like.
OLLAMA_MODEL=gemma4:12b
# PROMPT_MODEL=gemma4:12b
# EVAL_MODEL=qwen3-vl:8b

# ── Image generator (agent 2): "studio" or "diffusers" ──
IMAGE_BACKEND=studio

# Studio backend: load Qwen-Image-2.1 (or FLUX.2 klein) in the Unsloth Studio Image tab first.
STUDIO_URL=http://127.0.0.1:8888
# Create one in Unsloth Studio: avatar -> Settings -> API. Starts with sk-unsloth-
STUDIO_API_KEY=
# Optional overrides; by default steps/guidance come from the loaded model's preset.
# STUDIO_STEPS=25
# STUDIO_GUIDANCE=1.0

# Diffusers backend (FLUX.2 klein, 4-bit, runs inside this process)
DIFFUSERS_MODEL=black-forest-labs/FLUX.2-klein-4B
# HF_TOKEN=

# ── Loop control ──
MAX_ITERATIONS=3
PASS_SCORE=8
# Longest side of generated images. 1024 is safe on 8 GB; above that Qwen-Image-2.1 can OOM at VAE decode.
MAX_SIDE=1024
OUTPUT_DIR=outputs
